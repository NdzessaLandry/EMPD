#: .\templates\core\accueil.html:29
msgid ""
"\n"
"                EMPD est un espace consacré à l'étude, à l'enseignement\n"
"                et au partage de la Parole de Dieu. Découvrez des\n"
"                enseignements, des publications et des ressources\n"
"                destinés à accompagner votre cheminement dans la foi.\n"
"                "
