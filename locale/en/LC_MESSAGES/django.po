msgid ""
"Une école pour apprendre,\n"
"                approfondir et transmettre."
msgstr ""

#: .\templates\core\accueil.html:118
msgid ""
"\n"
"                L'École Mondiale de la Parole de Dieu souhaite offrir\n"
"                un environnement accessible à celles et ceux qui désirent\n"
"                approfondir leur connaissance des Écritures.\n"
"                "
msgstr ""

#: .\templates\core\accueil.html:126
msgid ""
"\n"
"                À travers des enseignements, des publications et différents\n"
"                supports pédagogiques, EMPD cherche à favoriser une étude\n"
"                attentive de la Bible et une compréhension plus approfondie\n"
"                de son message.\n"
"                "
msgstr ""

